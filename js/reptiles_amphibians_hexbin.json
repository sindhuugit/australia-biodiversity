      "transform": [
        {
          "lookup": "hex_id",
          "from": {
            "data": {
              "url": "data/reptiles_amphibians_hexbin.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "all_species": "number",
                  "reptiles_species": "number",
                  "amphibians_species": "number",
                  "all_time_series": "number",
                  "reptiles_time_series": "number",
                  "amphibians_time_series": "number"
                }
              }
            },
            "key": "hex_id",
            "fields": [
              "all_species",
              "reptiles_species",
              "amphibians_species",
              "all_time_series",
              "reptiles_time_series",
              "amphibians_time_series",
              "all_examples",
              "reptiles_examples",
              "amphibians_examples"
            ]
          }
        },
        {
          "calculate": "selectedGroup === 'Reptiles' ? datum.reptiles_species : selectedGroup === 'Amphibians' ? datum.amphibians_species : datum.all_species",
          "as": "species_count"
        },
        {
          "calculate": "selectedGroup === 'Reptiles' ? datum.reptiles_time_series : selectedGroup === 'Amphibians' ? datum.amphibians_time_series : datum.all_time_series",
          "as": "series_count"
        },
        {
          "calculate": "selectedGroup === 'Reptiles' ? datum.reptiles_examples : selectedGroup === 'Amphibians' ? datum.amphibians_examples : datum.all_examples",
          "as": "example_species"
        },
        {
          "filter": "datum.species_count > 0"
        },
        {
          "calculate": "datum.species_count === 1 ? '1' : datum.species_count === 2 ? '2' : datum.species_count <= 4 ? '3–4' : datum.species_count <= 7 ? '5–7' : '8+'",
          "as": "count_band"
        },
        {
          "calculate": "selectedGroup === 'Reptiles & Amphibians' ? 'Both groups' : selectedGroup",
          "as": "display_group"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.25,
        "opacity": 0.95,
        "clip": true
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "color": {
          "field": "count_band",
          "type": "ordinal",
          "title": "Distinct monitored species per hexagon",
          "scale": {
