
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Interactive proportional-symbol map showing distinct threatened bird species monitored across Australian regions, with smaller transparent circles and automatic state zoom.",

  "title": {
    "text": "Threatened Bird Monitoring Across Australia",
    "subtitle": "Circle size represents the number of distinct threatened bird species monitored in each region."
  },

  "width": 750,
  "height": 450,

  "params": [
    {
      "name": "chosenState",
      "value": "All states",
      "bind": {
        "input": "select",
        "options": [
          "All states",
          "New South Wales",
          "Victoria",
          "Queensland",
          "Western Australia",
          "South Australia",
          "Tasmania",
          "Northern Territory",
          "Australian Capital Territory"
        ],
        "name": "Filter by state: "
      }
    }
  ],

  "projection": {
    "type": "mercator",

    "center": {
      "expr": "chosenState === 'New South Wales' ? [147.6, -32.6] : chosenState === 'Victoria' ? [144.5, -37.2] : chosenState === 'Queensland' ? [144, -22.4] : chosenState === 'Western Australia' ? [122, -25.5] : chosenState === 'South Australia' ? [135.2, -30.5] : chosenState === 'Tasmania' ? [146.6, -42.1] : chosenState === 'Northern Territory' ? [133.5, -20] : chosenState === 'Australian Capital Territory' ? [149, -35.4] : [134, -28]"
    },

    "scale": {
      "expr": "chosenState === 'New South Wales' ? 1800 : chosenState === 'Victoria' ? 2500 : chosenState === 'Queensland' ? 1100 : chosenState === 'Western Australia' ? 950 : chosenState === 'South Australia' ? 1500 : chosenState === 'Tasmania' ? 3300 : chosenState === 'Northern Territory' ? 1100 : chosenState === 'Australian Capital Territory' ? 12000 : 590"
    },

    "translate": [375, 225]
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#EEF2E9",
        "stroke": "#A6B8A8",
        "strokeWidth": 0.9,
        "clip": true
      },

      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        }
      }
    },

    {
      "data": {
        "url": "data/bird_monitoring_regions.csv",
        "format": {
          "type": "csv",
          "parse": {
            "species_count": "number",
            "monitoring_records": "number",
            "latitude": "number",
            "longitude": "number"
          }
        }
      },

      "transform": [
        {
          "filter": "chosenState === 'All states' || datum.state === chosenState"
        }
      ],

      "mark": {
        "type": "circle",
        "color": "#D77A50",
        "stroke": "#173D34",
        "strokeWidth": 0.4,
        "opacity": 0.42,
        "clip": true
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "species_count",
          "type": "quantitative",
          "title": "Bird species monitored",

          "scale": {
            "type": "sqrt",
            "domain": [1, 15],
            "range": [16, 350]
          },

          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolFillColor": "#D77A50",
            "symbolStrokeColor": "#173D34",
            "symbolStrokeWidth": 0.4,
            "symbolOpacity": 0.55,
            "values": [2, 4, 6, 8, 10, 12, 14],
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleLimit": 350,
            "offset": 8
          }
        },

        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "region",
            "type": "nominal",
            "title": "Monitoring region"
          },
          {
            "field": "species_count",
            "type": "quantitative",
            "title": "Distinct monitored bird species",
            "format": ",d"
          },
          {
            "field": "monitoring_records",
            "type": "quantitative",
            "title": "Monitoring records",
            "format": ",d"
          },
          {
            "field": "latitude",
            "type": "quantitative",
            "title": "Region centroid latitude",
            "format": ".2f"
          },
          {
            "field": "longitude",
            "type": "quantitative",
            "title": "Region centroid longitude",
            "format": ".2f"
          }
        ]
      }
    }
  ],

  "config": {
    "background": "#FFFFFF",
    "font": "DM Sans",

    "view": {
      "stroke": null
    },

    "title": {
      "font": "DM Sans",
      "fontSize": 19,
      "fontWeight": 700,
      "color": "#173D34",
      "subtitleFont": "DM Sans",
      "subtitleFontSize": 12,
      "subtitleColor": "#586D61"
    },

    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#243B32",
      "titleColor": "#173D34"
    }
  }
}
