
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Distribution of recorded threat categories among distinct monitored species. The diverging chart separates lower and higher threat severity categories.",

  "title": {
    "text": "Share of Monitored Species by Recorded Threat Status"
  },

  "width": 720,
  "height": 250,

  "data": {
    "url": "data/species_status_diverging.csv",
    "format": {
      "type": "csv",
      "parse": {
        "count": "number",
        "group_total": "number",
        "percentage": "number",
        "start_pct": "number",
        "end_pct": "number"
      }
    }
  },

  "transform": [
    {
      "calculate": "format(datum.percentage, '.1f') + '%'",
      "as": "percentage_label"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 36,
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },

      "encoding": {
        "y": {
          "field": "group",
          "type": "nominal",
          "title": null,
          "sort": [
            "Reptiles & Amphibians",
            "Plants",
            "Birds",
            "Mammals"
          ],
          "axis": {
            "labelFontSize": 13,
            "labelLimit": 200,
            "labelPadding": 8
          }
        },

        "x": {
          "field": "start_pct",
          "type": "quantitative",
          "title": "Threat status (% of monitored species in each group)",

          "scale": {
            "domain": [-80, 80],
            "nice": false,
            "zero": true
          },

          "axis": {
            "values": [
              -80,
              -60,
              -40,
              -20,
              0,
              20,
              40,
              60,
              80
            ],
            "labelExpr": "abs(datum.value) + '%'",
            "labelFontSize": 12,
            "labelPadding": 6,
            "titleFontSize": 13,
            "titlePadding": 12,
            "grid": true,
            "gridColor": "#E8EEE7",
            "gridOpacity": 0.8
          }
        },

        "x2": {
          "field": "end_pct"
        },

        "color": {
          "field": "status",
          "type": "nominal",
          "title": "Recorded threat status",

          "scale": {
            "domain": [
              "Near Threatened",
              "Vulnerable",
              "Endangered",
              "Critically Endangered"
            ],
            "range": [
              "#9FB997",
              "#D1B36A",
              "#D47B4E",
              "#B54A3A"
            ]
          },

          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "labelFont": "DM Sans",
            "labelFontSize": 13,
            "labelLimit": 220,
            "titleFont": "DM Sans",
            "titleFontSize": 14,
            "symbolType": "square",
            "symbolSize": 180,
            "offset": 16,
            "rowPadding": 4,
            "columnPadding": 20
          }
        },

        "tooltip": [
          {
            "field": "group",
            "type": "nominal",
            "title": "Species group"
          },
          {
            "field": "status",
            "type": "nominal",
            "title": "Recorded threat status"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Monitored species",
            "format": ",d"
          },
          {
            "field": "percentage_label",
            "type": "nominal",
            "title": "Percentage of group"
          },
          {
            "field": "group_total",
            "type": "quantitative",
            "title": "Total monitored species in group",
            "format": ",d"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "rule",
        "stroke": "#173D34",
        "strokeWidth": 1.8
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    }
  ],

  "config": {
    "background": "#FFFFFF",
    "font": "DM Sans",

    "view": {
      "stroke": null
    },

    "title": {
      "font": "DM Sans",
      "fontSize": 19,
      "fontWeight": 700,
      "color": "#173D34",
      "anchor": "middle",
      "offset": 16
    },

    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#243B32",
      "titleColor": "#173D34"
    },

    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#243B32",
      "titleColor": "#173D34"
    }
  }
}
